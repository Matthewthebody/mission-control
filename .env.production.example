# PRODUCTION POSTURE EXAMPLE
# This file is intentionally fail-closed for production auth and Microsoft governance.
# It is not complete; functional secrets and environment-specific values still need to be supplied.

NODE_ENV=production
ALLOW_DEV_LOGIN=false
ALLOW_PASSWORD_LOGIN=false
ALLOW_PASSWORD_LOGIN_BREAK_GLASS_ONLY=true

MICROSOFT_ENTRA_AUTH_ENABLED=true
MICROSOFT_OUTLOOK_SYNC_ENABLED=false
OUTLOOK_APP_PERMISSION_FEATURES_ENABLED=false
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=https://mission-control.example.com/api/integrations/outlook/oauth/callback
OUTLOOK_SCOPES=offline_access User.Read Calendars.Read
OUTLOOK_TOKEN_ENCRYPTION_SECRET=
# Generic Mission Control Microsoft Entra employee sign-in uses the existing MICROSOFT_GRAPH_* app registration values below.
MICROSOFT_ENTRA_REDIRECT_URI=https://mission-control.example.com/auth/microsoft/callback
MICROSOFT_ENTRA_POST_LOGOUT_REDIRECT_URI=https://mission-control.example.com
MICROSOFT_ENTRA_STATE_MINUTES=15

AUTH_SESSION_HOURS=12
AUTH_ELEVATED_MINUTES=240
AUTH_PRIVILEGED_MODE_MINUTES=240
AUTH_BREAK_GLASS_MAX_MINUTES=30

MICROSOFT_365_GOVERNANCE_ENV=production
MICROSOFT_365_OPERATING_SYSTEM_ENV=production
MICROSOFT_365_DASHBOARD_INTEGRATION_ENV=production
MICROSOFT_365_MAIL_AUTOMATION_ENV=production
MICROSOFT_365_CLIENT_INTAKE_ENV=production
MICROSOFT_365_CLIENT_INTAKE_OPERATIONS_ENV=production
MICROSOFT_365_CLIENT_PORTAL_ENV=production
MICROSOFT_365_SMS_OPTIMIZATION_ENV=production

MICROSOFT_365_GOVERNANCE_STRICT_VALIDATION=true
MICROSOFT_365_OPERATING_SYSTEM_STRICT_VALIDATION=true
MICROSOFT_365_DASHBOARD_INTEGRATION_STRICT_VALIDATION=true
MICROSOFT_365_MAIL_AUTOMATION_STRICT_VALIDATION=true
MICROSOFT_365_CLIENT_INTAKE_STRICT_VALIDATION=true
MICROSOFT_365_CLIENT_INTAKE_OPERATIONS_STRICT_VALIDATION=true
MICROSOFT_365_CLIENT_PORTAL_STRICT_VALIDATION=true
MICROSOFT_365_SMS_OPTIMIZATION_STRICT_VALIDATION=true

# Required real production values below this line.
DB_URL=
JWT_SECRET=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_365_TENANT_DISPLAY_NAME=
MICROSOFT_365_TENANT_PRIMARY_DOMAIN=
MICROSOFT_365_SHAREPOINT_ROOT_URL=
MICROSOFT_365_SHAREPOINT_HUB_SITE_URL=
