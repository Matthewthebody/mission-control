SMS_FROM_NUMBER=
SMTP_FROM_ADDRESS=
MONDAY_API_TOKEN=
MONDAY_ITEM_URL_TEMPLATE=
HOME_LABOR_WIDGET_ENABLED=true
CORE_FOUNDATION_DIAGNOSTICS_ENABLED=true
CORE_FOUNDATION_WORKFLOW_ENGINE_ENABLED=true
CORE_FOUNDATION_OPERATIONAL_EVENTS_ENABLED=true
CORE_FOUNDATION_GLOBAL_SEARCH_ENABLED=true
CORE_FOUNDATION_ACTIVITY_TIMELINE_ENABLED=true
CORE_FOUNDATION_ADMIN_CONFIGURATION_ENABLED=true
CORE_FOUNDATION_APPROVAL_FRAMEWORK_ENABLED=true
CORE_FOUNDATION_REPORTING_ENABLED=true
CORE_FOUNDATION_STRICT_STARTUP_VALIDATION=false
CENTRAL_JOB_INTAKE_V1_ENABLED=false
VITE_CENTRAL_JOB_INTAKE_V1_ENABLED=false
TV_MODE_SHOW_EMPLOYEE_NAMES=false
AIRTABLE_TOKEN=
HOMEBASE_KEY=
