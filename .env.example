# DEVELOPMENT EXAMPLE ONLY
# This file is intentionally permissive for local development and local testing.
# It is not a recommended secure production posture.
# For required production auth posture, use `.env.production.example` and see:
# docs/microsoft365/phase1-enforcement-hardening-and-communications.md
# NODE_ENV must be set explicitly. Dev-login FAILS CLOSED when NODE_ENV is unset:
# an ambiguous environment (e.g. a deploy that forgot this variable) never enables
# passwordless login. ALLOW_DEV_LOGIN=true is honored only outside production.
NODE_ENV=development
ALLOW_DEV_LOGIN=true
ALLOW_PASSWORD_LOGIN=true
DB_URL=postgres://postgres:postgres@localhost:5432/pmc
JWT_SECRET=replace_me_current_secret
JWT_SECRET_PREVIOUS=
AUTH_SESSION_HOURS=8
AUTH_ELEVATED_MINUTES=10
AUTH_PRIVILEGED_MODE_MINUTES=15
AUTH_BREAK_GLASS_MAX_MINUTES=30
AUTH_COOKIE_NAME=pmc_session
AUTH_CSRF_COOKIE_NAME=pmc_csrf
INVITE_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30
AWS_REGION=us-east-1
S3_BUCKET=replace_me_bucket
AWS_ACCESS_KEY_ID=replace_me_access_key
AWS_SECRET_ACCESS_KEY=replace_me_secret_key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_MAPS_API_KEY=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_365_GOVERNANCE_ENV=development
MICROSOFT_365_TENANT_DISPLAY_NAME=
MICROSOFT_365_TENANT_PRIMARY_DOMAIN=
MICROSOFT_365_SHAREPOINT_ROOT_URL=
MICROSOFT_365_SHAREPOINT_HUB_SITE_URL=
MICROSOFT_365_POWER_PLATFORM_ENVIRONMENT_ID=
MICROSOFT_365_SECURITY_GROUP_PREFIX=PMC-DEV
MICROSOFT_365_OPERATING_SYSTEM_ENV=development
MICROSOFT_365_WORKSPACE_NAME_PREFIX=PMC DEV
MICROSOFT_365_DASHBOARD_INTEGRATION_ENV=development
MICROSOFT_365_DASHBOARD_INTEGRATION_STRICT_VALIDATION=false
MICROSOFT_365_MAIL_AUTOMATION_ENV=development
MICROSOFT_365_MAIL_AUTOMATION_ENABLED=false
MICROSOFT_365_MAIL_AUTOMATION_TIMEOUT_MS=8000
MICROSOFT_365_MAIL_AUTOMATION_FLOW_ENDPOINTS={}
MICROSOFT_365_MAIL_AUTOMATION_CALLBACK_SECRET=
MICROSOFT_365_MAIL_AUTOMATION_STRICT_VALIDATION=false
MICROSOFT_365_CLIENT_INTAKE_ENV=development
MICROSOFT_365_CLIENT_INTAKE_ENABLED=false
MICROSOFT_365_CLIENT_INTAKE_CALLBACK_SECRET=
MICROSOFT_365_CLIENT_INTAKE_STRICT_VALIDATION=false
MICROSOFT_365_CLIENT_INTAKE_OPERATIONS_ENV=development
MICROSOFT_365_CLIENT_INTAKE_OPERATIONS_ENABLED=false
MICROSOFT_365_CLIENT_INTAKE_OPERATIONS_STRICT_VALIDATION=false
MICROSOFT_365_CLIENT_PORTAL_ENV=development
MICROSOFT_365_CLIENT_PORTAL_ENABLED=false
MICROSOFT_365_CLIENT_PORTAL_SITE_URL=
MICROSOFT_365_CLIENT_PORTAL_AUTH_PROVIDER=entra_external_id
MICROSOFT_365_CLIENT_PORTAL_DEFAULT_HELP_MAILBOX_KEY=support_ops
MICROSOFT_365_CLIENT_PORTAL_STRICT_VALIDATION=false
MICROSOFT_365_SMS_OPTIMIZATION_ENV=development
MICROSOFT_365_SMS_OPTIMIZATION_ENABLED=false
MICROSOFT_365_SMS_PROVIDER=azure_communication_services
MICROSOFT_365_SMS_FROM_NUMBER=
MICROSOFT_365_SMS_TIMEOUT_MS=8000
MICROSOFT_365_SMS_FLOW_ENDPOINTS={}
MICROSOFT_365_SMS_CALLBACK_SECRET=
MICROSOFT_365_SMS_STRICT_VALIDATION=false
MICROSOFT_365_OPERATING_SYSTEM_STRICT_VALIDATION=false
MICROSOFT_365_GOVERNANCE_STRICT_VALIDATION=false
OUTLOOK_CALENDAR_TIMEZONE=America/Chicago
# Generic Mission Control Microsoft Entra employee sign-in is disabled by default in local dev.
# Use Password Sign-In or Local Dev Login unless you intentionally enable the app-wide Entra flow below.
MICROSOFT_ENTRA_AUTH_ENABLED=false
ALLOW_PASSWORD_LOGIN_BREAK_GLASS_ONLY=false
MICROSOFT_OUTLOOK_SYNC_ENABLED=false
OUTLOOK_APP_PERMISSION_FEATURES_ENABLED=false
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:4000/api/integrations/outlook/oauth/callback
OUTLOOK_SCOPES=offline_access User.Read Calendars.Read
# App-wide Microsoft Entra sign-in uses the existing MICROSOFT_GRAPH_* credentials plus the redirect values below.
# To test local Microsoft employee sign-in, set:
# MICROSOFT_ENTRA_AUTH_ENABLED=true
# MICROSOFT_GRAPH_CLIENT_ID=...
# MICROSOFT_GRAPH_CLIENT_SECRET=...
# MICROSOFT_GRAPH_TENANT_ID=...
MICROSOFT_ENTRA_REDIRECT_URI=http://localhost:4000/auth/microsoft/callback
MICROSOFT_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
MICROSOFT_ENTRA_STATE_MINUTES=15
MICROSOFT_TEAMS_MESSAGE_EXTENSION_ENABLED=false
MICROSOFT_TEAMS_PERSONAL_APP_ENABLED=false
MICROSOFT_TEAMS_COMMUNICATIONS_ENABLED=false
MICROSOFT_TEAMS_MEETINGS_ENABLED=false
COMMUNICATIONS_DIAGNOSTICS_ENABLED=true
COMMUNICATION_IDENTITY_LINKING_ENABLED=true
COMMUNICATION_IN_APP_ACTIONS_ENABLED=true
COMMUNICATION_HISTORY_ENABLED=true
COMMUNICATION_PROACTIVE_RULES_ENABLED=true
COMMUNICATION_POST_CALL_FOLLOW_UP_ENABLED=true
COMMUNICATION_PRE_CALL_CONTEXT_ENABLED=true
MICROSOFT_TEAMS_EMBEDDED_COMMUNICATIONS_ENABLED=true
COMMUNICATIONS_STRICT_STARTUP_VALIDATION=false
COMMUNICATION_DIAGNOSTICS_LOOKBACK_DAYS=14
MICROSOFT_TEAMS_BOT_APP_ID=
MICROSOFT_TEAMS_BOT_APP_PASSWORD=
MICROSOFT_TEAMS_DEV_BYPASS_AUTH=true
TEAMS_COMMUNICATION_GRAPH_TIMEOUT_MS=5000
TEAMS_COMMUNICATION_THROTTLE_MINUTES=5
TEAMS_MEETING_GRAPH_TIMEOUT_MS=5000
TEAMS_MEETING_SYNC_THROTTLE_MINUTES=3
OUTLOOK_TOKEN_ENCRYPTION_SECRET=
OUTLOOK_OAUTH_STATE_MINUTES=15
OUTLOOK_GRAPH_TIMEOUT_MS=5000
OUTLOOK_CONFLICT_TRAVEL_BUFFER_MINUTES=30
OUTLOOK_CONFLICT_MODE=warning
OUTLOOK_SYNC_CANCEL_MODE=cancel
TEAMS_OPERATIONAL_ALERTS_ENABLED=false
TEAMS_WEBHOOK_TIMEOUT_MS=5000
ZENDESK_ENABLED=false
ZENDESK_SUBDOMAIN=
ZENDESK_AUTH_MODE=api_token
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
