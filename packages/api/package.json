{
  "name": "@pmc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx scripts/migrate.ts",
    "reset:demo": "tsx scripts/reset-local-demo-db.ts --yes-reset-local-demo-db",
    "production-board:backfill-legacy": "tsx scripts/backfill-production-board-legacy.ts",
    "checklists:seed": "tsx scripts/seed-workflow-checklists.ts",
    "seed": "tsx scripts/seed.ts",
    "verify:fresh-db-contract": "tsx scripts/verify-fresh-db-contract.ts",
    "seed:mission-control-demo": "tsx scripts/seed-mission-control-demo.ts --allow-demo-data",
    "project-tracking:seed-demo": "tsx scripts/seed-project-tracking-demo.ts --allow-demo-data",
    "project-tracking:reset-demo": "tsx scripts/seed-project-tracking-demo.ts --allow-demo-data --reset",
    "client-command-center:seed-demo": "tsx scripts/seed-client-command-center-demo.ts --allow-demo-data",
    "client-command-center:reset-demo": "tsx scripts/seed-client-command-center-demo.ts --allow-demo-data --reset",
    "test": "node scripts/run-vitest-chunks.mjs",
    "test:smoke:jobs": "npm run test -- jobTruthLayer.test.ts",
    "test:smoke:workflow": "npm run test -- workflowStateEngine.test.ts",
    "test:smoke:exceptions": "npm run test -- urgentWatch.test.ts",
    "test:smoke:my-work": "npm run test -- employeeExperience.test.ts",
    "test:smoke:portal": "npm run test -- microsoft365ClientPortal.test.ts",
    "test:smoke:microsoft": "npm run test -- microsoftEntraAuth.test.ts outlookIntegration.test.ts webhookOutbox.test.ts microsoft365MailAutomation.test.ts outlookCalendarGraph.test.ts teamsMessaging.test.ts teamsMeetings.test.ts teamsMessageExtension.test.ts microsoftIntegrationObservability.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-presigned-post": "^3.883.0",
    "@types/pdfkit": "^0.17.5",
    "@pmc/timeclock-core": "0.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.0.8",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.4.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.3",
    "vitest": "^3.1.1"
  }
}
