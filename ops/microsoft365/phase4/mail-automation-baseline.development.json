  "logging_and_monitoring": {
    "queue_of_record": "integration_sync_operation plus microsoft_mail_automation_delivery",
    "callback_route": "/api/integrations/microsoft/email-automation/callback",
    "failure_queue_rule": "Dispatch failures live in integration_sync_operation and final send failures live in microsoft_mail_automation_delivery.",
    "alerting_rule": "Every dispatch or callback failure records a mail_automation diagnostics event and a delivery-level alerted event.",
    "retention_rule": "Keep mail automation delivery history and events as durable operational logs according to tenant retention policy.",
    "reconciliation_rule": "Dashboard remains authoritative; reconcile mailbox/template/backlink drift before replaying sends."
  },
  "execution_order": [
    { "order": 1, "title": "Confirm Phase 1 governance, Phase 2 operating system, and Phase 3 provisioning baselines are valid.", "owner": "Platform Engineering", "requires_tenant_admin": false, "rollback": "Do not enable Phase 4 mail automation until prerequisite diagnostics are healthy." },
    { "order": 2, "title": "Create or validate shared mailboxes and mailbox security groups in the tenant.", "owner": "Microsoft 365 Admin", "requires_tenant_admin": true, "rollback": "Remove send-as assignments and disable the mailbox from automation if governance checks fail." },
    { "order": 3, "title": "Create the SharePoint template library and upload initial governed templates.", "owner": "Department Operations", "requires_tenant_admin": true, "rollback": "Revert template files to the previous reviewed versions." },
    { "order": 4, "title": "Configure Power Automate flows and store invoke URLs in environment configuration.", "owner": "Platform Automation Owners", "requires_tenant_admin": true, "rollback": "Disable flow triggers and remove invoke URL configuration." },
    { "order": 5, "title": "Sync mailbox and template contracts into the dashboard.", "owner": "Platform Engineering", "requires_tenant_admin": false, "rollback": "Re-run contract sync against the last good baseline." },
    { "order": 6, "title": "Pilot manual queue and callback validation before enabling automated trigger paths.", "owner": "Operations Leadership", "requires_tenant_admin": false, "rollback": "Disable the feature flag and investigate failed delivery logs before broader rollout." }
  ],
  "manual_admin_checklist": [
    { "order": 1, "step": "Create the shared mailboxes and verify send-as rights are group-based.", "portal": "Exchange Admin Center", "requires_tenant_admin": true, "owner": "Microsoft 365 Admin" },
    { "order": 2, "step": "Create the Client Email Templates library and metadata columns.", "portal": "SharePoint Admin Center", "requires_tenant_admin": true, "owner": "SharePoint Admin" },
    { "order": 3, "step": "Upload approved template files and lock editing to mailbox or automation owners.", "portal": "SharePoint Site", "requires_tenant_admin": true, "owner": "Department Operations" },
    { "order": 4, "step": "Create or validate the managed Power Automate flows and capture the invoke URLs.", "portal": "Power Automate", "requires_tenant_admin": true, "owner": "Platform Automation Owners" },
    { "order": 5, "step": "Set MICROSOFT_365_MAIL_AUTOMATION_FLOW_ENDPOINTS and MICROSOFT_365_MAIL_AUTOMATION_CALLBACK_SECRET.", "portal": null, "requires_tenant_admin": false, "owner": "Platform Engineering" },
    { "order": 6, "step": "Run the baseline validation script and review /api/admin/system/microsoft-email-automation.", "portal": null, "requires_tenant_admin": false, "owner": "Platform Engineering" }
  ],
  "validation_checklist": [
    "Every flow key in the baseline has a configured invoke endpoint.",
    "Every client-facing automation send resolves to a shared mailbox alias.",
    "Template files live in the governed SharePoint library and are editable without code changes.",
    "Queue, dispatch, callback, failure, and replay outcomes are visible in dashboard-linked logs.",
    "A failed dispatch or callback creates both diagnostics visibility and a delivery-level failure record."
  ],
  "rollback_principles": [
    "Disable MICROSOFT_365_MAIL_AUTOMATION_ENABLED before changing mailbox or flow topology.",
    "Never delete delivery logs to hide failures; archive or remediate instead.",
    "Roll back template content in SharePoint before changing flow routing logic when copy is the issue.",
    "Remove or rotate callback secrets before reopening a failed environment to traffic."
  ]
}
